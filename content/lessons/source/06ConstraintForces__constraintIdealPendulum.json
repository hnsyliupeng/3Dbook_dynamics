    {
      "sourceRef": "index:10",
      "cellIndex": 10,
      "originalCellId": null,
      "type": "code",
      "source": "lambda1 = sm.symbols('lambda_1') # As many lambdas as constraints\nf1 = sm.Eq(sm.Function('f_1')(rho), rho- l)\nf1",
      "sourceSha256": "29da1dc5ceb62b80cb8ea968acb38248e3b233113fd0a0314124673fd7270a1e",
      "outputs": [
        {
          "type": "execute_result",
          "text/plain": "f₁(ρ) = -\\ell + ρ",
