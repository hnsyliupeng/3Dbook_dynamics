      "originalCellId": null,
      "type": "code",
      "source": "rho_EL_subs = rho_EL.subs(f1_subs).simplify()\nrho_EL_subs",
      "sourceSha256": "f1729ce1da0c063bca080fca52be842bf9d5019ec72e5e0b88ec70bead64f92f",
      "outputs": [
        {
          "type": "execute_result",
          "text/plain": "       ⎛      2           ⎞\nλ₁ = m⋅⎝\\ell⋅φ̇  + g⋅cos(φ)⎠",
          "text/latex": "$\\displaystyle \\lambda_{1} = m \\left(\\ell \\dot{\\phi}^{2} + g \\cos{\\left(\\phi \\right)}\\right)$"
        }
      ],
