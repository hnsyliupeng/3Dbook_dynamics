    {
      "sourceRef": "index:11",
      "cellIndex": 11,
      "originalCellId": null,
      "type": "markdown",
      "source": "## Kinetic energy",
      "sourceSha256": "2f68aa230b02710b84b00f6f21442ab6f947ca79634f8ed158bcaecaa08c264e",
      "outputs": [],
      "outputMimeTypes": [],
      "attachmentNames": [],
      "math": []
    },
    {
      "sourceRef": "index:12",
      "cellIndex": 12,
      "originalCellId": null,
      "type": "code",
      "source": "def kineticEnergyParticle(mass, position, frameOfReference):\n    \"\"\"\n    Given a mass and the position of a point particle in a frame of reference, it returns its kinetic energy.\n    \n    Parameters\n    ----------\n    mass: (sympy.core.symbol.Symbol)\n        of one particle\n    position: (sympy.physics.vector.vector.Vector)\n        of the particle's center of mass\n    frameOfReference: (sympy.physics.vector.frame.ReferenceFrame)\n        in which the position is expressed\n    \n    Returns\n    -------\n    Product of Sympy symbols (sympy.core.mul.Mul)\n        Kinetic Energy, T = (m/2) \\dot{\\vec{r}} \\cdot\\dot{\\vec{r}}\n    \"\"\"\n    velocity = position.dt(frameOfReference)\n    oneHalf = sm.Rational(1,2) # Rational: a quotient of integers\n    return oneHalf*mass*velocity.dot(velocity)",
      "sourceSha256": "5073720e49a816f101710526ba490ce3d148220f97181a5eb74d43c4dc0c4e35",
      "outputs": [],
      "outputMimeTypes": [],
      "attachmentNames": [],
      "pythonAst": {
        "imports": [],
        "calls": [
          "position.dt",
          "sm.Rational",
          "velocity.dot"
        ],
        "literalAssignments": {},
        "parseError": null
      }
    },
    {
      "sourceRef": "index:13",
      "cellIndex": 13,
      "originalCellId": null,
      "type": "code",
      "source": "# Kinetic energy of the system\nm_T = kineticEnergyParticle(m, m_r, e)\nT = sm.Eq(sm.Symbol('T'), m_T ).simplify()\nT",
      "sourceSha256": "f20cd38ae5f10516d9919c375bd904d22ff3e1d5caf900d3609c11ad703f0b18",
      "outputs": [
        {
          "type": "execute_result",
          "text/plain": "      ⎛ 2  2    2⎞\n    m⋅⎝ρ ⋅φ̇  + ρ̇ ⎠\nT = ──────────────\n          2       ",
          "text/latex": "$\\displaystyle T = \\frac{m \\left(\\rho^{2} \\dot{\\phi}^{2} + \\dot{\\rho}^{2}\\right)}{2}$"
        }
      ],
      "outputMimeTypes": [
        "image/png",
        "text/latex",
        "text/plain"
      ],
      "attachmentNames": [],
      "pythonAst": {
        "imports": [],
        "calls": [
          "kineticEnergyParticle",
          "simplify",
          "sm.Eq",
          "sm.Symbol"
        ],
        "literalAssignments": {},
        "parseError": null
      }
    },
    {
      "sourceRef": "index:14",
      "cellIndex": 14,
      "originalCellId": null,
      "type": "markdown",
      "source": "## Potential energy",
      "sourceSha256": "57037bf339490579c9b140d6900f272a39b809cf83409c33e04b4d022bc0b5a6",
      "outputs": [],
      "outputMimeTypes": [],
      "attachmentNames": [],
      "math": []
    },
    {
      "sourceRef": "index:15",
      "cellIndex": 15,
      "originalCellId": null,
      "type": "code",
      "source": "def gravitationalPotentialEnergy(mass, position, accelerationDueToGravity):\n    \"\"\"\n    It returns the gravitational potential energy of a particle of mass m whose position r is given in a frame of reference in which g is the Earth's gravitational acceleration.\n    \n    Parameters\n    ----------\n    accelerationDueToGravity: (sympy.physics.vector.vector.Vector)\n        vector oriented according to the frame of reference\n    mass: (sympy.core.symbol.Symbol\n        of the particle\n    position: (sympy.core.symbol.Symbol)\n        of the center of mass in a frame of reference related to accelerationDueToGravity\n    \n    Returns\n    -------\n    sympy.core.mul.Mul\n        Gravitational potential energy = - (m \\vec{g}) \\cdot{r}\n    \"\"\"\n    return - (mass * accelerationDueToGravity).dot(position)",
      "sourceSha256": "925f718d88f510536c1207a0b5e118381fe9883df35c453b8c51ae476e079d2f",
      "outputs": [],
      "outputMimeTypes": [],
      "attachmentNames": [],
      "pythonAst": {
        "imports": [],
        "calls": [
          "dot"
        ],
        "literalAssignments": {},
        "parseError": null
      }
    },
    {
      "sourceRef": "index:16",
      "cellIndex": 16,
      "originalCellId": null,
      "type": "code",
      "source": "# Gravitational potential energy\ng_vector = g* (-e.y) # acceleration due to gravity on the -y axis\nm_V = gravitationalPotentialEnergy(m, m_r, g_vector)\nV = sm.Eq(sm.Symbol('V'), m_V ).simplify()\nV",
      "sourceSha256": "0f7b41f2549ddac72db52d74cbb174b246b9340fac6b3537a048431e9daee2f7",
      "outputs": [
        {
          "type": "execute_result",
          "text/plain": "V = -g⋅m⋅ρ⋅cos(φ)",
          "text/latex": "$\\displaystyle V = - g m \\rho \\cos{\\left(\\phi \\right)}$"
        }
      ],
      "outputMimeTypes": [
        "image/png",
        "text/latex",
        "text/plain"
      ],
      "attachmentNames": [],
      "pythonAst": {
        "imports": [],
        "calls": [
          "gravitationalPotentialEnergy",
