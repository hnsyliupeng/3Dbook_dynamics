      }
    },
    {
      "sourceRef": "index:41",
      "cellIndex": 41,
      "originalCellId": null,
      "type": "markdown",
      "source": "These are substituted in the Euler-Lagrange equations.",
      "sourceSha256": "1ff6b0428c83962840821577437e972df534d36ba8c7004a1d4b8cc3d03bc620",
      "outputs": [],
      "outputMimeTypes": [],
      "attachmentNames": [],
      "math": []
    },
    {
      "sourceRef": "index:42",
      "cellIndex": 42,
      "originalCellId": null,
      "type": "code",
      "source": "f1_subs = {\n    rho : rho_f1,\n    rho.diff(t): rho_f1.diff(t),\n    rho.diff(t,2): rho_f1.diff(t,2)\n}",
      "sourceSha256": "5e327cd5ac5aae0430ac0ddc80ce2f91246603d10fffe5ca7bc6166ed66e83d5",
      "outputs": [],
      "outputMimeTypes": [],
      "attachmentNames": [],
      "pythonAst": {
