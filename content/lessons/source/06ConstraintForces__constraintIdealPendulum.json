    },
    {
      "sourceRef": "index:43",
      "cellIndex": 43,
      "originalCellId": null,
      "type": "code",
      "source": "phi_EL_subs = phi_EL.subs(f1_subs).simplify()\nphi_EL_subs",
      "sourceSha256": "71e31168fe18e83bcebc830df73ade0ad6cbc525bd7815a4bc2c0bf83e14ff3b",
      "outputs": [
        {
          "type": "execute_result",
          "text/plain": "\\ell⋅m⋅(\\ell⋅φ̈ + g⋅sin(φ)) = 0",
          "text/latex": "$\\displaystyle \\ell m \\left(\\ell \\ddot{\\phi} + g \\sin{\\left(\\phi \\right)}\\right) = 0$"
        }
      ],
      "outputMimeTypes": [
        "image/png",
