        }
      ]
    },
    {
      "sourceRef": "index:46",
      "cellIndex": 46,
      "originalCellId": null,
      "type": "code",
      "source": "phi_pp = sm.solve(phi_EL_subs, phi.diff(t,2) )[0]\nsm.Eq(phi.diff(t,2), phi_pp)",
      "sourceSha256": "be9d323bbc7e769a014b4356aa9843a876b93a233d23ae44922ef32cbea390e1",
      "outputs": [
        {
          "type": "execute_result",
          "text/plain": "    -g⋅sin(φ) \nφ̈ = ──────────\n       \\ell   ",
          "text/latex": "$\\displaystyle \\ddot{\\phi} = - \\frac{g \\sin{\\left(\\phi \\right)}}{\\ell}$"
        }
      ],
      "outputMimeTypes": [
