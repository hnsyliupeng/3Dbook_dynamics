    },
    {
      "sourceRef": "index:40",
      "cellIndex": 40,
      "originalCellId": null,
      "type": "code",
      "source": "sm.Eq(f1.rhs.diff(t,2), 0)",
      "sourceSha256": "0b393ce9a94aa2feead314dc9ace1af835e040e829682778b9f5dc1d33c23734",
      "outputs": [
        {
          "type": "execute_result",
          "text/plain": "ρ̈ = 0",
          "text/latex": "$\\displaystyle \\ddot{\\rho} = 0$"
        }
      ],
      "outputMimeTypes": [
