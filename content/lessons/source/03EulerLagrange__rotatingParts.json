        }
      ]
    },
    {
      "sourceRef": "6fa9564c-2dac-4c6b-9639-f2be79233e7c",
      "cellIndex": 3,
      "originalCellId": "6fa9564c-2dac-4c6b-9639-f2be79233e7c",
      "type": "markdown",
      "source": "## Physical parameters for the system",
      "sourceSha256": "4ec435a9af6d8aed0f89bb928f55271e410ee1fa883228ad7bc189e0ed276824",
      "outputs": [],
      "outputMimeTypes": [],
      "attachmentNames": [],
      "math": []
    },
    {
      "sourceRef": "0fb6f35a-90fb-4b78-ad98-5d51dd57c099",
      "cellIndex": 4,
      "originalCellId": "0fb6f35a-90fb-4b78-ad98-5d51dd57c099",
      "type": "code",
      "source": "import sympy as sm # import functions for symbolic manipulations\nfrom sympy.physics import mechanics as me # from sympy we use functions for mechanics\nme.init_vprinting() # dot notation for velocity and acceleration",
      "sourceSha256": "47cc9fd83cffe716d4bbead70b9c75481d194a8ce5f3eebc74e2dc4cf9fab241",
      "outputs": [],
      "outputMimeTypes": [],
      "attachmentNames": [],
      "pythonAst": {
        "imports": [
          "sympy",
          "sympy.physics"
        ],
        "calls": [
          "me.init_vprinting"
        ],
        "literalAssignments": {},
        "parseError": null
      }
    },
    {
      "sourceRef": "39a1dc07-1e6d-40e7-adb2-bbff7408a1f7",
      "cellIndex": 5,
      "originalCellId": "39a1dc07-1e6d-40e7-adb2-bbff7408a1f7",
      "type": "code",
      "source": "m, k, omega, l = sm.symbols('m, k, \\omega, \\ell', positive=True) # Parameters for this system\n\n# We define the generalized coordinates\ne = me.ReferenceFrame('e') # Cartesian frame of reference\nt = sm.symbols('t') # time",
      "sourceSha256": "d6540ad5e620095cc7f3eee63c7348c7d057fb022783d164dd20eb19f8f6015e",
      "outputs": [],
      "outputMimeTypes": [],
      "attachmentNames": [],
      "pythonAst": {
        "imports": [],
        "calls": [
          "me.ReferenceFrame",
          "sm.symbols"
        ],
        "literalAssignments": {},
        "parseError": null
      }
    },
    {
      "sourceRef": "636a49f8",
      "cellIndex": 6,
      "originalCellId": "636a49f8",
      "type": "markdown",
      "source": "## Option 1: work using a fixed frame of reference.",
      "sourceSha256": "dbf94e026e51314ff0464687f4197d52d037842dfef553fc42b03edb057291bb",
      "outputs": [],
      "outputMimeTypes": [],
      "attachmentNames": [],
      "math": []
    },
    {
      "sourceRef": "cf0ae20b",
      "cellIndex": 7,
      "originalCellId": "cf0ae20b",
      "type": "markdown",
      "source": "There are two things to define\n- the spring's length, related to $d$\n- the position of the particle of mass $m$\n\nThe pivot point around which the T spins can be the origin of the frame of reference $e$, with versor $\\hat{x}$ directed to the right and $\\hat{y}$ directed upward.\nThe particle's position vector is the sum of the vector from pivot point to the joint and the vector for the position of the spring with respect to the joint.\nThe position of the joint is",
      "sourceSha256": "af74c2a5abae3602a22b426bc0b17deadd69b350b81398dca8e2d3349f3645b6",
      "outputs": [],
      "outputMimeTypes": [],
      "attachmentNames": [],
      "math": [
        {
          "kind": "inline",
          "latex": "d"
        },
        {
          "kind": "inline",
          "latex": "m"
        },
        {
          "kind": "inline",
          "latex": "e"
        },
        {
          "kind": "inline",
          "latex": "\\hat{x}"
        },
        {
          "kind": "inline",
          "latex": "\\hat{y}"
        }
      ]
    },
    {
      "sourceRef": "8abeba7a",
      "cellIndex": 8,
      "originalCellId": "8abeba7a",
      "type": "code",
      "source": "vertex_r = l* (sm.cos(omega * t) * e.x + sm.sin(omega * t) * e.y) # joint's position",
      "sourceSha256": "016ee81b8932c848e9bc29046d42e677153494d778f6604eed26d92cde1a8694",
      "outputs": [],
      "outputMimeTypes": [],
      "attachmentNames": [],
      "pythonAst": {
        "imports": [],
        "calls": [
          "sm.cos",
          "sm.sin"
        ],
        "literalAssignments": {},
        "parseError": null
      }
    },
    {
      "sourceRef": "a10c5e31",
      "cellIndex": 9,
      "originalCellId": "a10c5e31",
      "type": "markdown",
      "source": "It's not hard to interpret the geometry to determine the projections of the vector for the spring on the selected axes.",
      "sourceSha256": "0acefe9fa927b4b7425f51a7cd62aa114d7646aef7478f73e614b94077f6e569",
      "outputs": [],
      "outputMimeTypes": [],
      "attachmentNames": [],
      "math": []
    },
    {
      "sourceRef": "e727c4cc",
      "cellIndex": 10,
      "originalCellId": "e727c4cc",
      "type": "code",
      "source": "d = me.dynamicsymbols('d') # the only generalized coordinate | distance from particle to joint\nparticle_r = vertex_r + d* (-sm.sin(omega * t) * e.x + sm.cos(omega * t) * e.y) # particles's position\nparticle_r",
      "sourceSha256": "fd60f5857b2d30b4117f79c868281c9e3d85dc3a21f20c48c01f068ad190fa40",
      "outputs": [
        {
          "type": "execute_result",
          "text/plain": "(\\ell⋅cos(\\omega⋅t) - d⋅sin(\\omega⋅t)) e_x + (\\ell⋅sin(\\omega⋅t) + d⋅cos(\\omeg ↪\n\n↪ a⋅t)) e_y",
          "text/latex": "$\\displaystyle (\\ell \\cos{\\left(\\omega t \\right)} - d \\sin{\\left(\\omega t \\right)})\\mathbf{\\hat{e}_x} + (\\ell \\sin{\\left(\\omega t \\right)} + d \\cos{\\left(\\omega t \\right)})\\mathbf{\\hat{e}_y}$"
        }
      ],
      "outputMimeTypes": [
        "image/png",
        "text/latex",
        "text/plain"
      ],
      "attachmentNames": [],
      "pythonAst": {
        "imports": [],
        "calls": [
          "me.dynamicsymbols",
          "sm.cos",
          "sm.sin"
        ],
        "literalAssignments": {},
        "parseError": null
      }
    },
    {
      "sourceRef": "e12c3a8c-f87c-4528-8ed1-adae8a69cfd7",
      "cellIndex": 11,
      "originalCellId": "e12c3a8c-f87c-4528-8ed1-adae8a69cfd7",
      "type": "markdown",
      "source": "## Option 2: rotating frame of reference\nWe device a cartesian frame of reference where $\\hat{e}_x$ is directed to the right and $\\hat{e}_y$ is directed upward.\n\nIf at $t=0$ the segment of length $l$ coincides with the horizontal, and it is directed to the right of the pivot point, the particle's position will be",
      "sourceSha256": "76026150c9dc7a883426e26f4bf7db83f63f45b632b56498b0bb4482fc94cdee",
      "outputs": [],
      "outputMimeTypes": [],
      "attachmentNames": [],
      "math": [
        {
          "kind": "inline",
          "latex": "\\hat{e}_x"
        },
        {
          "kind": "inline",
          "latex": "\\hat{e}_y"
        },
        {
          "kind": "inline",
          "latex": "t=0"
        },
        {
          "kind": "inline",
          "latex": "l"
        }
      ]
    },
    {
      "sourceRef": "84c21f6e-b909-497f-94f1-13ee07549265",
      "cellIndex": 12,
      "originalCellId": "84c21f6e-b909-497f-94f1-13ee07549265",
      "type": "code",
      "source": "particle_r = l* e.x + d* e.y\nparticle_r",
      "sourceSha256": "e8f8d5f3219d5141f5aa82d2d47631ab67dee40deb60991fe071e65ef9f5546c",
      "outputs": [
        {
          "type": "execute_result",
          "text/plain": "\\ell e_x + d e_y",
          "text/latex": "$\\displaystyle \\ell\\mathbf{\\hat{e}_x} + d\\mathbf{\\hat{e}_y}$"
        }
      ],
      "outputMimeTypes": [
        "image/png",
        "text/latex",
        "text/plain"
      ],
      "attachmentNames": [],
      "pythonAst": {
        "imports": [],
        "calls": [],
        "literalAssignments": {},
        "parseError": null
      }
    },
    {
      "sourceRef": "fc29a03d-e69b-4a22-8d9a-6f76df7bc3dd",
      "cellIndex": 13,
      "originalCellId": "fc29a03d-e69b-4a22-8d9a-6f76df7bc3dd",
      "type": "markdown",
      "source": "Such a 3D vector can be expressed in matrix notation as",
      "sourceSha256": "fb0c1381135c5dff6f0ba593faca19d3ae3919aad1bc4354635546ab04e78c06",
      "outputs": [],
      "outputMimeTypes": [],
      "attachmentNames": [],
      "math": []
    },
    {
      "sourceRef": "4234f2e4-2750-484e-89cd-10f816c5de2b",
      "cellIndex": 14,
      "originalCellId": "4234f2e4-2750-484e-89cd-10f816c5de2b",
      "type": "code",
      "source": "particle_r_matrix = sm.Matrix([[l], [d], [0]])\nparticle_r_matrix",
      "sourceSha256": "07f0d09663f1ee614dcdb29d1e6813bbe35f9f85146949e665ed9c05513d6f39",
      "outputs": [
        {
          "type": "execute_result",
          "text/plain": "⎡\\ell⎤\n⎢    ⎥\n⎢ d  ⎥\n⎢    ⎥\n⎣ 0  ⎦",
          "text/latex": "$\\displaystyle \\left[\\begin{matrix}\\ell\\\\d\\\\0\\end{matrix}\\right]$"
        }
      ],
      "outputMimeTypes": [
        "text/latex",
        "text/plain"
      ],
      "attachmentNames": [],
      "pythonAst": {
        "imports": [],
        "calls": [
          "sm.Matrix"
        ],
        "literalAssignments": {},
        "parseError": null
      }
    },
    {
      "sourceRef": "8a119e0a-8d90-4805-a5f8-e8a510e99397",
      "cellIndex": 15,
      "originalCellId": "8a119e0a-8d90-4805-a5f8-e8a510e99397",
      "type": "markdown",
      "source": "The effect of the constant angular speed $\\omega \\hat{z}$ can be represented by a rotation matrix using the angle $\\omega t$ around $\\hat{z}$.",
      "sourceSha256": "6eb354fdb51c82de2e934e4ea4d2736e901bface30a97d38ede2030d0de0a1bb",
      "outputs": [],
      "outputMimeTypes": [],
      "attachmentNames": [],
      "math": [
        {
          "kind": "inline",
          "latex": "\\omega \\hat{z}"
        },
        {
          "kind": "inline",
          "latex": "\\omega t"
        },
        {
          "kind": "inline",
          "latex": "\\hat{z}"
        }
      ]
    },
    {
      "sourceRef": "9bbaef6d-f6f9-47e7-acee-b3cd4b515d3f",
      "cellIndex": 16,
      "originalCellId": "9bbaef6d-f6f9-47e7-acee-b3cd4b515d3f",
      "type": "code",
      "source": "matrixRotation = sm.Matrix([[sm.cos(omega* t), -sm.sin(omega* t), 0], [ sm.sin(omega* t), sm.cos(omega* t), 0], [0,0,1] ] )\nmatrixRotation",
      "sourceSha256": "baf2c5127f83d19ee89c86c463e86dfb1143150f4c810eacf7f3f957703fed67",
      "outputs": [
        {
          "type": "execute_result",
          "text/plain": "⎡cos(\\omega⋅t)  -sin(\\omega⋅t)  0⎤\n⎢                                ⎥\n⎢sin(\\omega⋅t)  cos(\\omega⋅t)   0⎥\n⎢                                ⎥\n⎣      0              0         1⎦",
          "text/latex": "$\\displaystyle \\left[\\begin{matrix}\\cos{\\left(\\omega t \\right)} & - \\sin{\\left(\\omega t \\right)} & 0\\\\\\sin{\\left(\\omega t \\right)} & \\cos{\\left(\\omega t \\right)} & 0\\\\0 & 0 & 1\\end{matrix}\\right]$"
        }
      ],
      "outputMimeTypes": [
        "text/latex",
        "text/plain"
      ],
      "attachmentNames": [],
      "pythonAst": {
        "imports": [],
        "calls": [
          "sm.Matrix",
          "sm.cos",
          "sm.sin"
        ],
        "literalAssignments": {},
        "parseError": null
      }
    },
    {
      "sourceRef": "98c9b995-d550-4d35-93c0-f484d6e4fa32",
      "cellIndex": 17,
      "originalCellId": "98c9b995-d550-4d35-93c0-f484d6e4fa32",
      "type": "markdown",
      "source": "Direct multiplication allows us to find the components $\\hat{x}$ y $\\hat{y}$ of the particle's position at any $t$.",
      "sourceSha256": "b709c092afed6ad4c63a0b69cbb9312a19cf4362a019a3f46f08f90e0f742bc6",
      "outputs": [],
      "outputMimeTypes": [],
      "attachmentNames": [],
      "math": [
        {
          "kind": "inline",
          "latex": "\\hat{x}"
        },
        {
          "kind": "inline",
          "latex": "\\hat{y}"
        },
        {
          "kind": "inline",
          "latex": "t"
        }
      ]
    },
    {
      "sourceRef": "6233017f-d420-4929-b228-87baabb16308",
      "cellIndex": 18,
      "originalCellId": "6233017f-d420-4929-b228-87baabb16308",
      "type": "code",
      "source": "matrixRotation* particle_r_matrix",
      "sourceSha256": "b07eb21a69463233ea1492e85425e32fd55678d7122cbbcdb6dd2948e2a2d427",
      "outputs": [
        {
          "type": "execute_result",
          "text/plain": "⎡\\ell⋅cos(\\omega⋅t) - d⋅sin(\\omega⋅t)⎤\n⎢                                    ⎥\n⎢\\ell⋅sin(\\omega⋅t) + d⋅cos(\\omega⋅t)⎥\n⎢                                    ⎥\n⎣                 0                  ⎦",
          "text/latex": "$\\displaystyle \\left[\\begin{matrix}\\ell \\cos{\\left(\\omega t \\right)} - d \\sin{\\left(\\omega t \\right)}\\\\\\ell \\sin{\\left(\\omega t \\right)} + d \\cos{\\left(\\omega t \\right)}\\\\0\\end{matrix}\\right]$"
        }
      ],
      "outputMimeTypes": [
        "text/latex",
        "text/plain"
      ],
      "attachmentNames": [],
      "pythonAst": {
        "imports": [],
        "calls": [],
        "literalAssignments": {},
        "parseError": null
      }
    },
    {
      "sourceRef": "cdf843eb-1f6b-41a3-9cb7-7afc4efc803c",
      "cellIndex": 19,
      "originalCellId": "cdf843eb-1f6b-41a3-9cb7-7afc4efc803c",
      "type": "markdown",
      "source": "### Process automation",
      "sourceSha256": "d346ffce6a8772b3923a495e0cc43f15a63ad8f28d21c9d7c8dfa8b581ae5654",
      "outputs": [],
      "outputMimeTypes": [],
      "attachmentNames": [],
      "math": []
    },
    {
      "sourceRef": "2dd52a8b-b579-4625-a8ad-636f4d1f5099",
      "cellIndex": 20,
      "originalCellId": "2dd52a8b-b579-4625-a8ad-636f4d1f5099",
      "type": "markdown",
      "source": "There is no need to manually write the particle's position in a matrix format after writing the particle's position vector at $t=0$.\nThere is a function in `SymPy.physics.mechanics` that converts the vector into this format.",
      "sourceSha256": "4e55fde9d4490ca3aac786226fe77e9c783911caf9c20f97eca676558a553da2",
      "outputs": [],
      "outputMimeTypes": [],
      "attachmentNames": [],
      "math": [
        {
          "kind": "inline",
          "latex": "t=0"
        }
      ]
    },
    {
      "sourceRef": "fd2831df-3c29-4eb9-9201-de9b8ffe49a0",
      "cellIndex": 21,
      "originalCellId": "fd2831df-3c29-4eb9-9201-de9b8ffe49a0",
      "type": "code",
      "source": "particle_r.to_matrix(e)",
      "sourceSha256": "efa4443a11253c2405c0d1752a0353a9915334c0a9a465d3588bb6fed747c607",
      "outputs": [
        {
          "type": "execute_result",
          "text/plain": "⎡\\ell⎤\n⎢    ⎥\n⎢ d  ⎥\n⎢    ⎥\n⎣ 0  ⎦",
          "text/latex": "$\\displaystyle \\left[\\begin{matrix}\\ell\\\\d\\\\0\\end{matrix}\\right]$"
        }
      ],
      "outputMimeTypes": [
        "text/latex",
        "text/plain"
      ],
      "attachmentNames": [],
      "pythonAst": {
        "imports": [],
        "calls": [
          "particle_r.to_matrix"
        ],
        "literalAssignments": {},
        "parseError": null
      }
    },
    {
      "sourceRef": "86393715-2f38-4937-9e73-d9a60861a468",
      "cellIndex": 22,
      "originalCellId": "86393715-2f38-4937-9e73-d9a60861a468",
      "type": "markdown",
      "source": "In the same fashion, there is a function in SymPy which saves us the work of writing the rotation matrix manually.\n\n**Be careful!** SymPy uses the final frame of reference, so we have to indicate a rotation in the opposite direction than that of the device.",
      "sourceSha256": "16942429a699032ac27baa8a4b1c921dc54dc613405c20d0d0e49d64c3552b6d",
      "outputs": [],
      "outputMimeTypes": [],
      "attachmentNames": [],
      "math": []
    },
    {
      "sourceRef": "d2ca003f-d46f-4a35-b1a0-8291e889906b",
      "cellIndex": 23,
      "originalCellId": "d2ca003f-d46f-4a35-b1a0-8291e889906b",
      "type": "code",
      "source": "sm.rot_axis3(- omega* t) # there are variants of \"axis\" for axes 1 and 2",
      "sourceSha256": "09c7f8d598ba06353677236668c7758e5561853d6ee594efd435a23e2a4af2b4",
      "outputs": [
        {
          "type": "execute_result",
          "text/plain": "⎡cos(\\omega⋅t)  -sin(\\omega⋅t)  0⎤\n⎢                                ⎥\n⎢sin(\\omega⋅t)  cos(\\omega⋅t)   0⎥\n⎢                                ⎥\n⎣      0              0         1⎦",
