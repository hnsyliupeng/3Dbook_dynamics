      "sourceSha256": "b3ee484e120770c548c399fb01699c6fbf97c1b159628a30b6fa8b0945dcd101",
      "outputs": [
        {
          "type": "display_data",
          "text/plain": "<Figure size 640x480 with 1 Axes>"
        },
        {
          "type": "execute_result",
          "text/plain": "<sympy.plotting.plot.Plot at 0x7f4bf5d3f1c0>"
