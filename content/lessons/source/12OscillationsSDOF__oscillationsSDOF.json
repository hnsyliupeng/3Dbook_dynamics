      "source": "x_over_parameters = x_over_condInit.subs(parameters)\nsm.plot(x_over_parameters.rhs, (t,0, 5), ylabel='x [m]', xlabel='t [s]') ",
      "sourceSha256": "84d327c55fc20d55ea2048a0a26cbfc26b4c77d70a6cf10e0fc4717adadeca6d",
      "outputs": [
