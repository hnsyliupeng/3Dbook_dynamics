    {
      "sourceRef": "index:2",
      "cellIndex": 2,
      "originalCellId": null,
      "type": "markdown",
      "source": "![shabana_fig_1_11.png]([embedded image omitted])",
      "sourceSha256": "17fbd1cc2bf97a11357d110bb2178318ebb183f2e219632cf66b9a14ceaa5f81",
      "outputs": [],
      "outputMimeTypes": [],
      "attachmentNames": [],
