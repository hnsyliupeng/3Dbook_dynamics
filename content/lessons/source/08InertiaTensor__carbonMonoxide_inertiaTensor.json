        "parseError": null
      }
    },
    {
      "sourceRef": "index:35",
      "cellIndex": 35,
      "originalCellId": null,
      "type": "code",
      "source": "lambda_tensor = sm.Eq(\n  Iik_cm.lhs,\n  (Q.inv()* Iik_cm.rhs* Q).evalf(n=3),\n  evaluate=False\n)\nlambda_tensor",
      "sourceSha256": "48834700f213c463bd5dd0bec66d3840115a51f19dfe39ae00bde623c8002d63",
