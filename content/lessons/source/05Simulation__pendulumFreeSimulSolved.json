      }
    },
    {
      "sourceRef": "index:11",
      "cellIndex": 11,
      "originalCellId": null,
      "type": "markdown",
      "source": "The position of $m_2$ is described using the constraint.",
      "sourceSha256": "4e3a79e69fdb45237643bb0c3cd3b6824a732bc3a5ce36de3daf008aaf064dbe",
      "outputs": [],
      "outputMimeTypes": [],
      "attachmentNames": [],
      "math": [
        {
          "kind": "inline",
          "latex": "m_2"
        }
      ]
    },
    {
      "sourceRef": "index:12",
      "cellIndex": 12,
      "originalCellId": null,
      "type": "code",
      "source": "m2_r = m1_r + l* (sm.cos(phi)* (- e.y) +  sm.sin(phi)* (e.x) ) # position of mass 2: defined by the constraint\nm1_r, m2_r",
      "sourceSha256": "55ade69b1cde942b6572493ed67395b3a4603296d55ab72867808960b1cac97b",
      "outputs": [
        {
          "type": "execute_result",
          "text/plain": "(x e_x, (\\ell⋅sin(φ) + x) e_x + -\\ell⋅cos(φ) e_y)",
          "text/latex": "$\\displaystyle \\left( x\\mathbf{\\hat{e}_x}, \\  (\\ell \\sin{\\left(\\phi \\right)} + x)\\mathbf{\\hat{e}_x} -  \\ell \\cos{\\left(\\phi \\right)}\\mathbf{\\hat{e}_y}\\right)$"
        }
      ],
