        "parseError": null
      }
    },
    {
      "sourceRef": "index:16",
      "cellIndex": 16,
      "originalCellId": null,
      "type": "markdown",
      "source": "### Potential energy",
      "sourceSha256": "c4e1d9bbe4ac97af11309b316d6e19cb673a58ee3eb782b1cd7331a9ee715940",
      "outputs": [],
      "outputMimeTypes": [],
      "attachmentNames": [],
      "math": []
    },
    {
      "sourceRef": "index:17",
      "cellIndex": 17,
      "originalCellId": null,
      "type": "code",
      "source": "def energyPotentialGravitational(mass, position, accelerationGravity):\n    \"\"\"\n    Provides the gravitational potential energy of a particle of mass m and position r in a given frame of reference in which g is the acceleration due to gravity.\n    \n    Parameters\n    ----------\n    accelerationGravity: (sympy.physics.vector.vector.Vector)\n        vector oriented according to the frame of reference\n    mass: (sympy.core.symbol.Symbol\n        of the body\n    position: (sympy.core.symbol.Symbol)\n        of the center of mass in a frame of reference related to the one for the acceleration due to gravity\n\n    Returns\n    -------\n    Sympy Equality (sympy.core.relational.Equality)\n        The potential energy of the system is made explicit on the right-hand side, as a function of the generalized coordinates and velocities, and time.\n    coordinateGeneralized: Sympy Symbol (sympy.core.symbol.Symbol)\n        V = - (m \\vec{accelerationGravity}) \\cdot{position}\n    \"\"\"\n    V_gravitational = sm.Eq(\n        sm.Symbol('V_\\mathrm{gravitational}'),\n        - (mass* accelerationGravity).dot(position)\n        ).simplify()\n    return V_gravitational",
      "sourceSha256": "29aa64627c5fb643722cb0234c33e67eff5f5cdc561c524c2ef2f7ec4e93730c",
      "outputs": [],
      "outputMimeTypes": [],
      "attachmentNames": [],
      "pythonAst": {
        "imports": [],
        "calls": [
          "dot",
          "simplify",
          "sm.Eq",
          "sm.Symbol"
        ],
        "literalAssignments": {},
        "parseError": null
      }
    },
    {
      "sourceRef": "index:18",
      "cellIndex": 18,
      "originalCellId": null,
      "type": "code",
      "source": "g_vector = g* (-e.y) # acceleration due to gravity on the -y axis\nm1_V = energyPotentialGravitational(m1, m1_r, g_vector)\nm2_V = energyPotentialGravitational(m2, m2_r, g_vector)",
      "sourceSha256": "1f9a956d66f8258c8f88f527ce3c473fe0c1155c701d96cf1e154b78864ead83",
      "outputs": [],
      "outputMimeTypes": [],
      "attachmentNames": [],
      "pythonAst": {
        "imports": [],
        "calls": [
          "energyPotentialGravitational"
        ],
        "literalAssignments": {},
        "parseError": null
      }
    },
    {
      "sourceRef": "index:19",
      "cellIndex": 19,
      "originalCellId": null,
      "type": "code",
      "source": "V = sm.Eq(\n  m1_V.lhs,\n  m1_V.rhs + m2_V.rhs\n  ).simplify()\nV",
      "sourceSha256": "2ecc1bf991bdf15792b6519945707691623951ceb820f66f5fdcc9bb6bc07f66",
      "outputs": [
        {
          "type": "execute_result",
          "text/plain": "V_\\mathrm{gravitational} = -\\ell⋅g⋅m₂⋅cos(φ)",
          "text/latex": "$\\displaystyle V_\\mathrm{gravitational} = - \\ell g m_{2} \\cos{\\left(\\phi \\right)}$"
        }
      ],
