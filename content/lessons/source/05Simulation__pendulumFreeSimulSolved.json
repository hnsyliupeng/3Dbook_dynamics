    {
      "sourceRef": "index:5",
      "cellIndex": 5,
      "originalCellId": null,
      "type": "code",
      "source": "import sympy as sm # import functions for symbolic manipulations\nfrom sympy.physics import mechanics as me # from sympy we use functions for mechanics\nme.init_vprinting() # dot notation for velocity and acceleration",
      "sourceSha256": "47cc9fd83cffe716d4bbead70b9c75481d194a8ce5f3eebc74e2dc4cf9fab241",
      "outputs": [],
      "outputMimeTypes": [],
      "attachmentNames": [],
      "pythonAst": {
