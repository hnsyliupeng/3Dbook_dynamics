    {
      "sourceRef": "index:4",
      "cellIndex": 4,
      "originalCellId": null,
      "type": "markdown",
      "source": "## Symbolic solution",
      "sourceSha256": "1178d14f5c231dfa69bbfc6ccb6f358d82d369e460552ace3258042a1d3dbe6a",
      "outputs": [],
