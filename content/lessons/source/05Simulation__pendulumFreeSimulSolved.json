    {
      "sourceRef": "index:9",
      "cellIndex": 9,
      "originalCellId": null,
      "type": "markdown",
      "source": "#### Positions as functions of the generalized coordinates",
      "sourceSha256": "6c1eed66c9ef4deb1cabe475abd2c367e9e8a3e09f8a0cafe5a5b749751c73cc",
      "outputs": [],
      "outputMimeTypes": [],
      "attachmentNames": [],
      "math": []
    },
    {
      "sourceRef": "index:10",
      "cellIndex": 10,
      "originalCellId": null,
      "type": "code",
      "source": "e = me.ReferenceFrame('e') # Cartesian frame of reference\nm1_r = x* (e.x) # position of mass 1: x = x(t)",
      "sourceSha256": "0b9841a247eccfc9599b05ba276f0749cf52d5a16cb0cf8d4ef83508d36230bb",
      "outputs": [],
      "outputMimeTypes": [],
      "attachmentNames": [],
