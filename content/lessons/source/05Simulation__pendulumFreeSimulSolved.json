      "originalCellId": null,
      "type": "code",
      "source": "# physical parameters\nm1, m2, l, g = sm.symbols(r'm_1, m_2, \\ell, g', positive=True)\n\n# positions as functions of the generalized coordinates\nt = sm.symbols('t') # time\nx, phi = me.dynamicsymbols('x, phi')",
      "sourceSha256": "3c91542e62cf32c11aa22a3d48ea74fe4fd20032bc367f07b9fc108ec82e740a",
      "outputs": [],
